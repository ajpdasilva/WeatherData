services:
  db:
    container_name: weather_postgres
    image: postgres:17.6
    environment:
      POSTGRES_DB: ${POSTGRES_DB}
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    ports:
      - "2345:5432"
    volumes:
      - weather-data:/var/lib/postgresql/data
      - ./postgres/initdb/airflow_init.sql:/docker-entrypoint-initdb.d/airflow_init.sql
      - ./postgres/initdb/weather_init.sql:/docker-entrypoint-initdb.d/weather_init.sql
    networks:
      - weather_network

  af:
    container_name: weather_airflow
    image: apache/airflow:3.1.3
    ports:
      - "${AIRFLOW_PORT}:8080"
    environment:
      AIRFLOW__DATABASE__SQL_ALCHEMY_CONN: postgresql+psycopg2://airflow:airflow@db/airflow
    volumes:
      - ./config:/opt/airflow/config
      - ./dags:/opt/airflow/dags
      - ./data:/opt/airflow/data/
      - ./logs:/opt/airflow/logs
      - ./plugins:/opt/airflow/plugins
      - ./scripts:/opt/airflow/scripts
    depends_on:
      - db
    env_file:
      - .env
    networks:
      - weather_network
    command:
      bash -c "airflow db migrate && airflow standalone"

  pgadmin:
    image: dpage/pgadmin4
    container_name: weather_pgadmin
    environment:
      PGADMIN_DEFAULT_EMAIL: ${PGADMIN_EMAIL}
      PGADMIN_DEFAULT_PASSWORD: ${PGADMIN_PWD}
    ports:
      - "${PGADMIN_PORT}:80"
    volumes:
      - weather-pgadmin:/var/lib/pgadmin
    networks:
      - weather_network
    depends_on:
      - db

volumes:
  weather-data:
  weather-pgadmin:

networks:
  weather_network:
    driver: bridge
